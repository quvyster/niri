[Unit]
Description=Protected Wake-on-LAN HTTP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/pcbot-wake/wake_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/etc/pcbot-wake

[Install]
WantedBy=multi-user.target
