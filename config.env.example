# Telegram bot token from @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to control this machine.
# Use /whoami after first start to learn your ID.
ALLOWED_USER_IDS=

# Dangerous: lets allowed users run shell commands as the service user.
ALLOW_TERMINAL=false
TERMINAL_TIMEOUT=8

# Local Jarvis model settings.
JARVIS_MODEL=qwen3:4b
JARVIS_GOOSE_BIN=/home/quvy/.local/bin/goose
JARVIS_GOOSE_PROVIDER=ollama
JARVIS_GOOSE_MODE=auto
JARVIS_GOOSE_MAX_TURNS=18
JARVIS_HISTORY_ENABLED=true
JARVIS_HISTORY_TURNS=10

# Optional smarter primary provider. If it fails, Jarvis falls back to local Ollama.
# OpenRouter has free models, but requires an API key and has rate limits.
# JARVIS_PRIMARY_PROVIDER=openrouter
# JARVIS_PRIMARY_MODEL=openrouter/free
# JARVIS_PRIMARY_API_KEY=your-openrouter-api-key

# Wake-on-LAN targets this bot can wake.
# Format: name=mac@host:port or name=mac@host1:port|host2:port
# For this PC on the local LAN. VPS must have a route/VPN/forward to this broadcast address.
WAKE_TARGETS=homepc=bc:5f:f4:be:2d:01@192.168.3.255:9

# Optional ESP32 wake bridge. ESP32 polls http://VPS:ESP_WAKE_PORT/esp32/wake
# and sends Wake-on-LAN locally inside the home network.
ESP_WAKE_ENABLED=false
ESP_WAKE_SECRET=change-me-long-random-token
ESP_WAKE_HOST=0.0.0.0
ESP_WAKE_PORT=8787
ESP_WAKE_TTL=120
ESP_WAKE_STATE=/etc/pcbot-vps/esp_wake_state.json
