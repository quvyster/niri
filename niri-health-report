def check_lan_servers(issues, infos):
    config = load_env()
    raw_hosts = config.get("LAN_SERVER_HOSTS", "")
    hosts = [x.strip() for x in raw_hosts.replace(";", ",").split(",") if x.strip()]
    if not hosts:
        add_info(infos, "LAN servers", "не настроены")
        return
    for host in hosts:
        open_ports = []
        for port in [22, 25, 53, 80, 443, 587, 993, 995, 5222, 5269, 8000, 8080, 8443]:
            sock = socket.socket()
            sock.settimeout(1.0)
            try:
                sock.connect((host, port))
                open_ports.append(port)
            except OSError:
                pass
            finally:
                sock.close()
        if not open_ports:
            add_issue(issues, f"LAN server {host} недоступен", "нет открытых проверяемых TCP-портов")
            continue
        expected = {22, 80, 443}
        missing = sorted(expected - set(open_ports))
        if missing:
            add_issue(issues, f"LAN server {host}: не хватает базовых портов", f"open={open_ports}, missing={missing}")
        else:
            add_info(infos, f"LAN server {host}", "open ports: " + ", ".join(map(str, open_ports)))


def build_report():
    issues = []
    infos = []
    started = time.time()
    for check in [
        check_failed_units,
        check_services,
        check_network_and_wol,
        check_local_api,
        check_disks,
        check_journal,
        check_configs,
        check_packages_gpu_temps,
        check_vps,
        check_lan_servers,
    ]:
        try:
            check(issues, infos)
        except Exception as exc:
            add_issue(issues, f"Ошибка проверки {check.__name__}", repr(exc))

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    host = socket.gethostname()
    status = "OK" if not issues else f"Проблем: {len(issues)}"
    lines = [
        f"Niri daily system report",
        f"{host} · {now}",
        f"Статус: {status}",
        "",
    ]
    if issues:
        lines.append("Проблемы:")
        for i, (title, detail) in enumerate(issues, 1):
            lines.append(f"{i}. {title}")
            if detail:
                lines.append(short(detail, 1000))
        lines.append("")
    lines.append("Проверки:")
    for title, detail in infos:
        if detail:
            lines.append(f"- {title}: {detail}")
        else:
            lines.append(f"- {title}")
    lines.append("")
    lines.append(f"Время проверки: {time.time() - started:.1f}s")
    return "\n".join(lines)


def split_messages(text):
    chunks = []
    while len(text) > MAX_TELEGRAM:
        cut = text.rfind("\n", 0, MAX_TELEGRAM)
        if cut < 1000:
            cut = MAX_TELEGRAM
        chunks.append(text[:cut].rstrip())
        text = text[cut:].lstrip()
    if text:
        chunks.append(text)
    return chunks


def send_telegram(config, text):
    token = config.get("BOT_TOKEN", "").strip()
    chat_ids = config.get("REPORT_CHAT_IDS") or config.get("ALLOWED_USER_IDS", "")
    targets = [x.strip() for x in chat_ids.replace(" ", "").split(",") if x.strip()]
    if not token or not targets:
        raise SystemExit("BOT_TOKEN/REPORT_CHAT_IDS не настроены")
    proxy = config.get("HTTPS_PROXY") or config.get("https_proxy")
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({"https": proxy})) if proxy else urllib.request.build_opener()
    for chat_id in targets:
        for chunk in split_messages(text):
            data = urllib.parse.urlencode({"chat_id": chat_id, "text": chunk}).encode()
            req = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage", data=data)
            with opener.open(req, timeout=25) as resp:
                resp.read()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--print", action="store_true", dest="print_only")
    parser.add_argument("--send", action="store_true")
    args = parser.parse_args()
    report = build_report()
    if args.print_only or not args.send:
        print(report)
    if args.send:
        send_telegram(load_env(), report)


if __name__ == "__main__":
    main()
